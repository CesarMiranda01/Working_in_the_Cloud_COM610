# Environment variables declared in this file are automatically made available to Prisma.
# See the documentation for more detail: https://pris.ly/d/prisma-schema#accessing-environment-variables-from-the-schema

# Prisma supports the native connection string format for PostgreSQL, MySQL, SQLite, SQL Server, MongoDB and CockroachDB.
# See the documentation for all the connection string options: https://pris.ly/d/connection-strings

# Configuración del servidor
PORT=3000

# Configuración de MongoDB (sin autenticación)
# DATABASE_URL="mongodb://localhost:27017/db_prueba?directConnection=true"
# DATABASE_URL="mongodb://localhost:27017/db_prueba?directConnection=true&replicaSet=rs0"
DATABASE_URL="mongodb://localhost:27017/db_prueba?replicaSet=rs0"


# Si necesitaras autenticación en el futuro:
# DATABASE_URL=mongodb://usuario:contraseña@localhost:27017/db_prueba?authSource=admin